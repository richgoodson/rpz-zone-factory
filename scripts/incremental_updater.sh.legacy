#!/bin/sh
# ═══════════════════════════════════════════════════════════════════════════
# LEGACY / UNUSED — kept for reference only.
#
# This script was an early standalone attempt at incremental RPZ updates.
# In v0.6.0, the logic was rewritten and inlined into run-rpz.sh as:
#
#   extract_domains_from_zone   — parse a rendered .db file into bare domains
#   build_nsupdate_batch        — generate nsupdate input from additions/deletions
#   run_incremental_for_zone    — diff, apply, rotate snapshots
#   seed_feed_snapshot          — establish a baseline from a full rebuild
#
# The inlined version differs from this legacy script in several important
# ways:
#
#   1. Correct CNAME target per zone type:
#        - block zones  → CNAME .             (NXDOMAIN)
#        - allowlist    → CNAME rpz-passthru. (policy passthru)
#      This script always wrote rpz-passthru, which would have corrupted
#      any block zone it was run against.
#
#   2. Fixed the comm -23 bug (was comparing sorted old vs unsorted new,
#      producing spurious "deletions").
#
#   3. Integrated with run-rpz.sh's config, logging, and TSIG key handling
#      instead of running as a standalone script with its own env vars.
#
#   4. Per-zone error handling: a failed nsupdate on one zone falls back
#      to a full rebuild for that zone only, while other zones continue.
#
# Do not run this script. See run-rpz.sh for the current implementation.
# ═══════════════════════════════════════════════════════════════════════════

# incremental_updater.sh — Apply incremental changes to RPZ zones via nsupdate
# Usage: incremental_updater.sh <zone_name> <old_feed_file> <new_feed_file>

set -eu

ZONE_NAME="$1"
OLD_FEED="$2"
NEW_FEED="$3"

# Validate inputs
if [ ! -f "$OLD_FEED" ] || [ ! -f "$NEW_FEED" ]; then
    echo "ERROR: Both old and new feed files must exist" >&2
    exit 1
fi

# Configuration (can be overridden via environment or .run-rpz.conf)
ALLOW_SERVER="${ALLOW_SERVER:-localhost}"
ALLOW_ZONE="${ALLOW_ZONE:-rpz.local}"
TSIG_KEY_FILE="${TSIG_KEY_FILE:-/etc/bind/tsig/rpz-update.key}"
RNDC_BIN="${RNDC_BIN:-rndc}"
NSUPDATE_BIN="${NSUPDATE_BIN:-nsupdate}"
ALLOW_TTL="${ALLOW_TTL:-300}"
SKIP_WILDCARD="${SKIP_WILDCARD:-0}"

# Temporary files
OLD_SORTED=$(mktemp)
NEW_SORTED=$(mktemp)
ADDITIONS=$(mktemp)
DELETIONS=$(mktemp)

# Sort both feeds
sort "$OLD_FEED" > "$OLD_SORTED"
sort "$NEW_FEED" > "$NEW_SORTED"

# Find additions (lines only in new feed)
comm -13 "$OLD_SORTED" "$NEW_SORTED" > "$ADDITIONS"

# Find deletions (lines only in old feed)
comm -23 "$OLD_SORTED" "$NEW_FEED" > "$DELETIONS"

# Function to apply nsupdate commands
apply_nsupdate() {
    local nsupdate_bin="$1"
    local action="$2"
    local domain_list="$3"
    local zone="$4"
    
    if [ ! -s "$domain_list" ]; then
        echo "  No $action entries"
        return 0
    fi
    
    echo "  Processing $action: $(wc -l < "$domain_list") entries"
    
    # Process each domain in the list
    while IFS= read -r domain; do
        # Skip empty lines
        [ -z "$domain" ] && continue
        
        # Build nsupdate commands for this domain
        _commands="server ${ALLOW_SERVER}
zone ${zone}
update add ${domain}.${zone}. ${ALLOW_TTL} IN CNAME rpz-passthru."

        if [ "$action" = "additions" ]; then
            if [ $SKIP_WILDCARD -eq 0 ]; then
                _commands="${_commands}
update add *.${domain}.${zone}. ${ALLOW_TTL} IN CNAME rpz-passthru."
            fi
        else  # deletions
            _commands="${_commands}
update delete ${domain}.${zone}. IN CNAME
update delete *.${domain}.${zone}. IN CNAME"
        fi

        _commands="${_commands}
send"

        # Execute nsupdate with TSIG
        if ! printf '%s\n' "$_commands" | "$nsupdate_bin" -k "$TSIG_KEY_FILE" 2>&1; then
            echo "ERROR: nsupdate failed for domain: $domain" >&2
            return 1
        fi
    done < "$domain_list"
    
    return 0
}

# Apply additions
if ! apply_nsupdate "$NSUPDATE_BIN" "additions" "$ADDITIONS" "$ALLOW_ZONE"; then
    echo "ERROR: Failed to apply additions" >&2
    rm -f "$OLD_SORTED" "$NEW_SORTED" "$ADDITIONS" "$DELETIONS"
    exit 1
fi

# Apply deletions
if ! apply_nsupdate "$NSUPDATE_BIN" "deletions" "$DELETIONS" "$ALLOW_ZONE"; then
    echo "ERROR: Failed to apply deletions" >&2
    # Clean up additions if deletions fail? Usually we want to keep additions
    # but report the failure
    rm -f "$OLD_SORTED" "$NEW_SORTED" "$ADDITIONS" "$DELETIONS"
    exit 1
fi

# Sync and clean journal
echo "Syncing zone and removing journal..."
if ! "$RNDC_BIN" sync -clean "$ALLOW_ZONE" 2>&1; then
    echo "WARNING: rndc sync -clean failed" >&2
    # Not critical but should be reported
fi

# Cleanup
rm -f "$OLD_SORTED" "$NEW_SORTED" "$ADDITIONS" "$DELETIONS"

echo "Incremental update completed successfully"
exit 0
